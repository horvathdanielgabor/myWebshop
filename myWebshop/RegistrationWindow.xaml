<Window x:Class="myWebshop.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myWebshop"
        mc:Ignorable="d"
        Title="" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" MaxWidth="400" MaxHeight="600" MinHeight="600" MinWidth="400">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/Main_RD.xaml"/>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF5B99ED" Offset="0.1"/>
            <GradientStop Color="#FF030067" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <StackPanel Margin="20,20,20,0">
        <TextBlock Text="Sign up for shopping" FontSize="38" TextAlignment="Center"/>
        <Grid Height="225" Margin="0,70,0,70">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Text="User name" />
            <TextBox
            x:Name="registrateUser_TBX"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="250"
            Height="32"
            HorizontalAlignment="Left"/>
            <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Text="Password" />
            <PasswordBox
            x:Name="registratePassword_PBX"
            Grid.Row="3"
            VerticalAlignment="Top"
            Width="250"
            Height="32"
            HorizontalAlignment="Left" />
            <TextBlock
            Grid.Row="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Text="Repeat password" />
            <PasswordBox
            x:Name="registratePasswordAgain_PBX"
            Grid.Row="5"
            VerticalAlignment="Top"
            Width="250"
            Height="32"
            HorizontalAlignment="Left" />
        </Grid>
        <Button x:Name="login_BTN" FontSize="32" Style="{StaticResource roundBTN}" Content="Registrate"/>
        <Button x:Name="signUp_BTN" FontSize="32" Margin="0,50,0,0" Content="Login here"/>
    </StackPanel>
</Window>
