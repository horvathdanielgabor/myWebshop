<Window x:Class="myWebshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myWebshop"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/Main_RD.xaml"/>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="50" Background="MidnightBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="createProduct_BTN" Click="createProduct_BTN_Click" Grid.Column="0" Style="{StaticResource linkBTN}" Content="Hozzon létre új terméket" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="Account_BTN" Click="Account_BTN_Click" Grid.Column="2" Style="{StaticResource linkBTN}" Content="Fiók" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel DockPanel.Dock="Left" Width="150" Background="DimGray">
            <Expander Header="Kategóriák" Margin="10,0,0,0">
                <StackPanel x:Name="filters_STP">
                </StackPanel>
            </Expander>
        </StackPanel>
        <ScrollViewer DockPanel.Dock="Right" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
            <StackPanel x:Name="productsView_STP">
                
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
