<Window x:Class="myWebshop.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myWebshop"
        mc:Ignorable="d"
        Title="AccountWindow" Height="800" Width="600"
        Background="CadetBlue"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/Main_RD.xaml"/>
    </Window.Resources>
    <StackPanel Margin="10,20,10,20">
        <Grid Height="650">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1.25*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                <TextBlock Text="Felhasználó név"
                HorizontalAlignment="Left" />
                <TextBox
                x:Name="User_TBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Email cím" />
                <TextBox
                x:Name="Email_TBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left"/>
            </StackPanel>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Text="Keresztnév"/>
                    <TextBox
                        x:Name="FirstName_TBX"
                        Width="125"
                        Height="32"
                        HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Text="Vezetéknév"/>
                    <TextBox
                        x:Name="LastName_TBX"
                        Width="125"
                        Height="32"
                        HorizontalAlignment="Left"/>
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Row="3" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Jelszó" />
                <PasswordBox
                x:Name="Password_PBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Row="4" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Telefonszám" />
                <TextBox
                x:Name="PhoneNumber_TBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="5" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Város" />
                <TextBox
                x:Name="City_TBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="6" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Ország" />
                <TextBox
                x:Name="Country_TBX"
                Width="250"
                Height="32"
                HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="7" HorizontalAlignment="Left">
                <TextBlock
                HorizontalAlignment="Left"
                Text="Születési dátum" />
                <DatePicker
                x:Name="BirthDate_DPR"
                Width="250"
                Height="42"
                HorizontalAlignment="Left"
                FontSize="24"/>
            </StackPanel>
            <StackPanel Grid.Row="8">
                <WrapPanel HorizontalAlignment="Left">
                    <TextBlock
                    HorizontalAlignment="Left"
                    Text="A szerepköröd: " />
                    <TextBlock
                    x:Name="Role_TBC"
                    HorizontalAlignment="Left" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Left">
                    <TextBlock
                    HorizontalAlignment="Left"
                    Text="A hűség pontjaid: " />
                    <TextBlock
                    x:Name="LoyaltyPoints_TBC"
                    HorizontalAlignment="Left" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock HorizontalAlignment="Left" Text="Fiók létrehozásának ideje:"/>
                    <TextBlock x:Name="CreatedAt_TBC" HorizontalAlignment="Left"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <WrapPanel Margin="0,20,0,0">
            <Button x:Name="close_BTN" Click="close_BTN_Click" Style="{StaticResource roundBTN}" FontSize="32" Content="Bezárás"/>
            <Button x:Name="save_BTN" Click="save_BTN_Click" Style="{StaticResource roundBTN}" FontSize="32" Content="Mentés"/>
            <Button x:Name="logOut_BTN" Click="logOut_BTN_Click" Style="{StaticResource roundBTN}" FontSize="32" Content="Kijelentkezés"/>
        </WrapPanel>
    </StackPanel>
</Window>
